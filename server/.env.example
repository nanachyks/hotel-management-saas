PORT=3001
DATABASE_URL=postgres://hotel:hotel@localhost:5432/hotel_dev
TEST_DATABASE_URL=postgres://hotel:hotel@localhost:5432/hotel_test
JWT_SECRET=change-this-to-a-random-secret-string
RESEND_API_KEY=
EMAIL_FROM=HotelEase <noreply@yourdomain.com>
CORS_ORIGINS=http://localhost:5173
# Base URL of the client app, used to build links in emails (verify/reset).
# Defaults to http://localhost:5173 if unset.
CLIENT_URL=http://localhost:5173
# Supabase project used for room-photo storage (Settings -> API in the Supabase dashboard).
# Required for POST/DELETE /api/rooms/:id/photo; the rest of the app works without it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Set only when running behind a reverse proxy/load balancer, to the number of
# trusted hops (e.g. 1). Leave unset for direct/local deployments so client IP
# cannot be spoofed via X-Forwarded-For.
TRUST_PROXY=
# Paystack keys for subscription billing (Settings -> API Keys & Webhooks in the
# Paystack dashboard). Without these, the Subscriptions page shows "Payment
# gateway not configured" and paid plan upgrades are disabled.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Set to true to allow `npm run seed` to insert demo data (admin123/owner123
# login) when NODE_ENV=production. Leave unset in real production environments.
ALLOW_SEED_IN_PRODUCTION=
